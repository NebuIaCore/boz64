// boz64.exe's resources: the icon (the game's launcher icon, made by tools/mkicon.py; window_win.cpp loads it as 1)
// and the version information Windows shows in the file's properties. The manifest is boz64.manifest (CMake merges
// it into the one the linker writes).
#include <winver.h>

1 ICON "boz64.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BOZ64 port"
            VALUE "FileDescription", "BOZ64 for Windows (Black Ops Zombies, 64-bit port)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "boz64"
            VALUE "OriginalFilename", "boz64.exe"
            VALUE "ProductName", "BOZ64"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
