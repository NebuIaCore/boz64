  <assemblyIdentity type="win32" name="BOZ64.Windows" version="1.0.0.0" processorArchitecture="amd64"/>
  <description>BOZ64 for Windows</description>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
